# ==============================================================================
# MINIMAL DOCKERFILE (Generated by AST Tree-Shaker)
# ==============================================================================
# Source: precursor/run_loop.py
# Generated: 2025-10-29
# Analysis: AST tree-shaking, dependency pruning
# Size reduction: ~95% (800MB → 45MB estimated)
# ==============================================================================

FROM python:3.9-slim

LABEL maintainer="AST Tree-Shaker"
LABEL description="Minimal environment for precursor alignment loop"
LABEL tree-shaken="true"

WORKDIR /app

# ==============================================================================
# DEPENDENCIES (Tree-shaken - only what's actually used)
# ==============================================================================

# Only external dependency detected via AST analysis
RUN pip install --no-cache-dir \
    openai==1.0.0

# Standard library used:
#   ✓ json, os, re, time, subprocess (built-in)
#   ✓ dataclasses, pathlib, typing (built-in Python 3.9+)
# No additional packages needed!

# ==============================================================================
# APPLICATION FILES (Only required files)
# ==============================================================================

# Main script
COPY run_loop.py /app/

# Pattern catalog (16 files, referenced in code)
COPY patterns/ /app/patterns/

# Input data
COPY data/chat_run.json /app/data/

# Create output directories
RUN mkdir -p /app/precards /app/validated /app/reports

# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environment variables (detected from os.getenv calls)
ENV PREC_EXTRACT_MODEL=gpt-4.1-mini
ENV PREC_JUDGE_MODEL=gpt-4.1-mini
ENV PREC_SUMMARY_MODEL=gpt-4.1-mini
ENV PREC_MAX_MESSAGES=0
ENV PREC_KEYCHAIN_SERVICE=openai
ENV PREC_KEYCHAIN_ACCOUNT=${USER}

# API key (must be provided at runtime)
ENV OPENAI_API_KEY=""

# ==============================================================================
# RUNTIME
# ==============================================================================

# Health check (verify dependencies loaded)
RUN python3 -c "import openai, json, os, re, time, subprocess; print('✓ Dependencies validated')"

# Default command
CMD ["python3", "run_loop.py"]

# ==============================================================================
# IMAGE SIZE COMPARISON
# ==============================================================================
# Standard Dockerfile with full requirements.txt:  ~800MB
# This tree-shaken Dockerfile:                     ~45MB
# Reduction:                                       94.4%
# ==============================================================================

# ==============================================================================
# USAGE
# ==============================================================================
# Build:
#   docker build -f Dockerfile.minimal -t alignment-loop:minimal .
#
# Run:
#   docker run -e OPENAI_API_KEY=$OPENAI_API_KEY alignment-loop:minimal
#
# Interactive:
#   docker run -it -e OPENAI_API_KEY=$OPENAI_API_KEY alignment-loop:minimal bash
# ==============================================================================
